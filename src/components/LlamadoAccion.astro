---
// Sección de llamado a la acción final
import EnlaceTelegram from "./EnlaceTelegram.astro";
import BotonEscuchar from "./BotonEscuchar.astro";
import CodigoQR from "./CodigoQR.astro";
---

<section id="llamado-accion" class="llamado-accion seccion-tarjeta seccion-tarjeta--destacada">
  <div class="contenido">
    <h2>No pierdas más tiempo en filas innecesarias</h2>
    <BotonEscuchar variante="claro" />
    <p>
      Consulta antes de salir de casa y disfruta de más tranquilidad, menos esperas y la certeza de
      ir solo cuando el medicamento esté disponible.
    </p>
    <EnlaceTelegram class="boton boton-claro boton-grande">
      Escribirle a Alba en Telegram
    </EnlaceTelegram>
  </div>
  <CodigoQR variante="claro" />
</section>

<style>
  .llamado-accion {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    text-align: left;
    padding-top: clamp(2.5rem, 5vw, 4rem);
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .contenido {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    max-width: 560px;
  }

  .llamado-accion h2,
  .llamado-accion p {
    color: #ffffff;
  }
</style>
