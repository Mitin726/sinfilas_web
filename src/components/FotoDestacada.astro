---
// Foto con el tratamiento visual común del sitio: formas decorativas detrás
// (naranja y azul de la marca) y un globo de chat opcional, como los de Telegram.
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  src: ImageMetadata;
  alt: string;
  forma?: "circulo" | "redondeada";
  /** Texto del globo de chat decorativo (no lo leen los lectores de pantalla). */
  globo?: string;
  /** Ancho máximo en px con que se muestra la foto. */
  ancho: number;
}

const { src, alt, forma = "redondeada", globo, ancho } = Astro.props;
---

<figure class:list={["foto", `foto--${forma}`]} style={`--ancho: ${ancho}px`}>
  <span class="forma forma--naranja" aria-hidden="true"></span>
  <span class="forma forma--azul" aria-hidden="true"></span>
  <Image
    class="imagen"
    src={src}
    alt={alt}
    widths={[ancho, ancho * 2]}
    sizes={`(max-width: 640px) 80vw, ${ancho}px`}
  />
  {globo && (
    <span class="globo" aria-hidden="true">
      {globo}
    </span>
  )}
</figure>

<style>
  .foto {
    position: relative;
    width: min(var(--ancho), 80vw);
    margin: 1.5rem auto;
  }

  .imagen {
    position: relative;
    z-index: 1;
    width: 100%;
    height: auto;
    object-fit: cover;
    border: 6px solid #ffffff;
    box-shadow: 0 22px 44px rgba(22, 62, 84, 0.18);
  }

  .foto--circulo .imagen {
    aspect-ratio: 1;
    border-radius: 50%;
  }

  .foto--redondeada .imagen {
    aspect-ratio: 4 / 3;
    border-radius: 1.75rem;
  }

  .forma {
    position: absolute;
    z-index: 0;
    border-radius: 50%;
  }

  .forma--naranja {
    top: -6%;
    right: -8%;
    width: 42%;
    aspect-ratio: 1;
    background: var(--secondary-soft);
  }

  .forma--azul {
    bottom: -8%;
    left: -10%;
    width: 55%;
    aspect-ratio: 1;
    background: var(--primary-soft-strong);
  }

  .globo {
    position: absolute;
    z-index: 2;
    bottom: 6%;
    right: -6%;
    max-width: 80%;
    padding: 0.6rem 1rem;
    border-radius: 1.1rem 1.1rem 0.3rem 1.1rem;
    background: #e2f7cb;
    color: #111b21;
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.3;
    box-shadow: 0 8px 20px rgba(17, 27, 33, 0.16);
  }

  @media (max-width: 640px) {
    .globo {
      right: 0;
    }
  }
</style>
