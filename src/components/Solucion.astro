---
// Sección La solución: consultar antes de ir
import BotonEscuchar from "./BotonEscuchar.astro";
import FotoDestacada from "./FotoDestacada.astro";
import imagenSolucion from "../assets/imagen_solucion.png";
---

<section id="solucion" class="solucion-layout seccion-tarjeta seccion-tarjeta--suave">
  <div class="solucion-texto">
    <div class="antetitulo">La solución</div>
    <h2>Existe una forma más simple</h2>
    <BotonEscuchar />
    <p>
      Antes de salir de casa, puedes preguntar si el medicamento está disponible y evitar un viaje
      largo o una fila innecesaria. Así puedes decidir con calma y ahorrar tiempo, energía y
      preocupación.
    </p>
  </div>
  <div class="solucion-visual">
    <FotoDestacada
      src={imagenSolucion}
      alt="Señora mayor consultando en su celular, desde la sala de su casa"
      globo="✅ ¡Sí está disponible!"
      ancho={420}
    />
  </div>
</section>

<style>
  .solucion-layout {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: center;
    gap: 2.5rem;
  }

  .solucion-texto {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .solucion-visual {
    display: flex;
    justify-content: center;
  }

  @media (max-width: 860px) {
    .solucion-layout {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
