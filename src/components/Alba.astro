---
// Sección Conoce a Alba: presentación del asistente
import EnlaceTelegram from "./EnlaceTelegram.astro";
import BotonEscuchar from "./BotonEscuchar.astro";
import FotoDestacada from "./FotoDestacada.astro";
import fotoAlba from "../assets/alba_perfil.png";
---

<section id="alba" class="alba-layout seccion-tarjeta">
  <div class="alba-texto">
    <div class="antetitulo">Conoce a Alba</div>
    <h2>Te presentamos a Alba, tu asistente virtual</h2>
    <BotonEscuchar />
    <p>
      Alba es una asistente virtual que puedes escribir por Telegram como si fuera un mensaje
      normal. Solo escribe el nombre del medicamento que necesitas y ella te responde en segundos
      con la información sobre su disponibilidad. No reemplaza al personal de salud, pero sí ayuda a
      ahorrar tiempo, esfuerzo y desplazamientos innecesarios.
    </p>
    <EnlaceTelegram class="boton boton-primario boton-grande">
      Escribirle a Alba en Telegram
    </EnlaceTelegram>
  </div>
  <div class="alba-visual">
    <FotoDestacada
      src={fotoAlba}
      alt="Retrato de Alba, la asistente virtual"
      forma="circulo"
      globo="¡Hola! Soy Alba 👋"
      ancho={320}
    />
  </div>
</section>

<style>
  .alba-layout {
    display: grid;
    grid-template-columns: 1.3fr 0.7fr;
    align-items: center;
    gap: 1rem;
  }

  .alba-texto {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }

  .alba-visual {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  @media (max-width: 640px) {
    .alba-layout {
      grid-template-columns: minmax(0, 1fr);
    }

    .alba-visual {
      order: 1;
    }

    .alba-texto {
      order: 2;
      align-items: center;
      text-align: center;
    }
  }
</style>
