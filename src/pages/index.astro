---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Problema from "../components/Problema.astro";
import Solucion from "../components/Solucion.astro";
import Alba from "../components/Alba.astro";
import ComoFunciona from "../components/ComoFunciona.astro";
import Ejemplos from "../components/Ejemplos.astro";
import Respuestas from "../components/Respuestas.astro";
import PrimeraVez from "../components/PrimeraVez.astro";
import PreguntasFrecuentes from "../components/PreguntasFrecuentes.astro";
import LlamadoAccion from "../components/LlamadoAccion.astro";
import Footer from "../components/Footer.astro";
import BotonFijoMovil from "../components/BotonFijoMovil.astro";
---

<BaseLayout>
  <Header />
  <main>
    <Hero />
    <Problema />
    <Solucion />
    <Alba />
    <ComoFunciona />
    <Ejemplos />
    <Respuestas />
    <PrimeraVez />
    <PreguntasFrecuentes />
    <LlamadoAccion />
  </main>
  <Footer />
  <BotonFijoMovil />
</BaseLayout>
