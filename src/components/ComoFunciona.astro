---
// Sección Cómo funciona: pasos simples
import { pasos } from "../data/pasos";
import BotonEscuchar from "./BotonEscuchar.astro";
---

<section id="como-funciona" class="como-funciona seccion-tarjeta">
  <h2>Así de fácil es usar a Alba</h2>
  <BotonEscuchar />
  <ol class="pasos">
    {pasos.map(({ titulo, descripcion }, i) => (
      <li class="paso">
        <span class="paso-numero" aria-hidden="true">
          {i + 1}
        </span>
        <h3>
          <span class="sr-only">Paso {i + 1}: </span>
          {titulo}
        </h3>
        <p>{descripcion}</p>
      </li>
    ))}
  </ol>
</section>

<style>
  .como-funciona {
    display: grid;
    gap: 1.5rem;
  }

  .como-funciona h2 {
    margin: 0;
  }

  .pasos {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .paso {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.5rem;
    border-radius: 1.1rem;
    background: var(--surface-alt);
    border: 1px solid var(--border);
  }

  .paso h3,
  .paso p {
    margin: 0;
  }

  .paso-numero {
    display: grid;
    place-items: center;
    width: 3.2rem;
    height: 3.2rem;
    border-radius: 50%;
    background: var(--secondary);
    color: var(--on-secondary);
    font-size: 1.5rem;
    font-weight: 900;
    box-shadow: 0 8px 16px rgba(232, 155, 82, 0.3);
  }

  @media (max-width: 860px) {
    .pasos {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
