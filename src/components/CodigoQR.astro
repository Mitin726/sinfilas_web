---
// Código QR que abre el chat de Alba. Se genera al compilar (SVG, sin JS) y
// solo se muestra en pantallas grandes: sirve a quien está en un computador.
import QRCode from "qrcode";
import { site } from "../config/site";

interface Props {
  /** "claro" para usarlo sobre fondos oscuros. */
  variante?: "normal" | "claro";
}

const { variante = "normal" } = Astro.props;

const svg = await QRCode.toString(site.telegramUrl, {
  type: "svg",
  margin: 1,
  errorCorrectionLevel: "M",
  color: { dark: "#163e54", light: "#ffffff" },
});
---

<div class:list={["qr", { "qr--claro": variante === "claro" }]}>
  <div class="codigo" role="img" aria-label="Código QR para abrir el chat de Alba en Telegram">
    <Fragment set:html={svg} />
  </div>
  <p class="texto-qr">
    <strong>¿Estás en un computador?</strong> Apunta la cámara de tu celular a este código y se
    abrirá el chat de Alba.
  </p>
</div>

<style>
  .qr {
    display: none;
  }

  @media (min-width: 901px) {
    .qr {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 1.25rem;
      max-width: 520px;
      padding: 1rem 1.25rem;
      border-radius: 1.1rem;
      background: #ffffff;
      border: 1px solid var(--border);
    }
  }

  .codigo {
    flex-shrink: 0;
    width: 150px;
    height: 150px;
  }

  .codigo :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* Dos clases: le gana a reglas como ".llamado-accion p" (texto blanco). */
  .qr .texto-qr {
    flex: 1 1 200px;
    margin: 0;
    color: var(--text);
  }

  .qr--claro {
    border-color: transparent;
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.18);
  }
</style>
