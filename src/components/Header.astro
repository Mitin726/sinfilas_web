---
// Header: logo/nombre del proyecto, navegación simple y acceso directo a Alba
import { site } from "../config/site";
import { navegacion } from "../data/navegacion";
import EnlaceTelegram from "./EnlaceTelegram.astro";
import TamanoTexto from "./TamanoTexto.astro";
---

<div class="barra-accesibilidad">
  <TamanoTexto />
</div>

<header class="site-header">
  <div class="brand-wrap">
    <img class="brand-logo" src={site.logo} alt="" />
    <a href="#hero">{site.nombre}</a>
  </div>
  <nav aria-label="Navegación principal">
    {navegacion.map(({ href, texto }) => (
      <a href={href}>{texto}</a>
    ))}
  </nav>
  <div class="header-accion">
    <EnlaceTelegram class="boton boton-primario">Escribirle a Alba</EnlaceTelegram>
  </div>
</header>

<style>
  .barra-accesibilidad {
    display: flex;
    justify-content: flex-end;
    width: min(1120px, calc(100% - 2rem));
    margin: 0.75rem auto 0;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem 1rem;
    margin-top: 0.5rem;
    background: rgba(255, 255, 255, 0.92);
    border: 1px solid var(--border);
    border-radius: 0 0 1.1rem 1.1rem;
    box-shadow: 0 8px 18px rgba(22, 62, 84, 0.08);
    backdrop-filter: blur(8px);
  }

  .brand-wrap {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .brand-logo {
    width: auto;
    height: 44px;
    display: block;
  }

  header a {
    font-weight: 700;
    color: var(--primary-dark);
  }

  .brand-wrap a {
    font-size: 1.4rem;
    font-weight: 900;
    letter-spacing: -0.02em;
  }

  header nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
  }

  header nav a {
    padding: 0.7rem 1rem;
    border-radius: 999px;
    color: var(--primary);
    transition:
      background-color 0.2s ease,
      box-shadow 0.2s ease,
      color 0.2s ease;
  }

  header nav a:hover,
  header nav a:focus-visible {
    background: var(--primary-soft);
  }

  @media (max-width: 900px) {
    .header-accion {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .barra-accesibilidad {
      justify-content: center;
    }

    /* En celulares el header no queda fijo: ocuparía mucho espacio y ya
       existe el botón fijo de abajo (BotonFijoMovil). */
    .site-header {
      position: static;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }

    header nav {
      justify-content: flex-start;
      margin-left: -0.6rem;
    }

    header nav a {
      padding: 0.6rem 0.6rem;
    }
  }
</style>
